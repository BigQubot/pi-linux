# Multi match flags
selects.config_setting_group(
    name = "flag_sdio_pwrctrl",
    match_all = [
        ":config_sdio_pwrctrl",
        ":config_sdio_support",
    ],
)

selects.config_setting_group(
    name = "config_not_usb_support",
    match_any = [
        ":config_sdio_support",
        ":config_pcie_support",
    ],
)

selects.config_setting_group(
    name = "flag_for_ipcam",
    match_all = [
        ":config_for_ipcam",
        ":config_not_usb_support",
    ],
)

selects.config_setting_group(
    name = "flag_usb_bt",
    match_any = [
        ":config_usb_bt",
        ":config_usb_support",
    ],
)

selects.config_setting_group(
    name = "flag_align_8bytes",
    match_all = [
        ":config_align_8bytes",
        ":config_usb_support",
    ],
)

selects.config_setting_group(
    name = "flag_usb_align_data",
    match_all = [
        ":config_usb_align_data",
        ":config_usb_support",
